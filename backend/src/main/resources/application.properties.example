spring.application.name=backend
spring.datasource.url=${STOREMATE_DB_URL:jdbc:mysql://localhost:3306/smartstore}
spring.datasource.username=${STOREMATE_DB_USERNAME:root}
spring.datasource.password=${STOREMATE_DB_PASSWORD}
spring.jpa.hibernate.ddl-auto=update
storemate.dev.auto-approve=false
storemate.dev.any-qr=false
storemate.dev.seed-products=true
